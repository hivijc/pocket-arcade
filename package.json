{
  "name": "backyard-minigolf",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "solve": "vite-node scripts/solve-hole.ts",
    "ingest": "vite-node scripts/ingest.ts",
    "ace-scan": "vite-node scripts/ace-scan.ts",
    "eval-hole": "vite-node scripts/eval-hole.ts",
    "dev:paper-route": "vite --open /games/paper-route/",
    "ingest:paper-route": "vite-node games/paper-route/scripts/ingest.ts",
    "dev:bluebird-run": "vite --open /games/bluebird-run/",
    "ingest:bluebird-run": "vite-node games/bluebird-run/scripts/ingest.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^5.1.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vite-node": "^3.2.4",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
